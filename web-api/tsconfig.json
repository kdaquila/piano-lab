// Builds the web API package to dist/ (`npm run build:web`).
{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "composite": true,
        "rootDir": "src",
        "outDir": "dist",
        // Kept with the output, so deleting dist/ means a full rebuild.
        "tsBuildInfoFile": "dist/.tsbuildinfo",
        "declaration": true,
        "sourceMap": true
    },
    "include": ["src"]
}
