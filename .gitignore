# --- C++ ------------------------------------------------------------------------------------------

# Build output (one folder per CMake preset)
/build/

# Personal CMake presets (CMakePresets.json is shared; this file is each person's own)
CMakeUserPresets.json

# Compile database, if a tool copies it to the repo root (the real one is in build/<preset>/)
/compile_commands.json

# clangd's index
/.cache/

# Visual Studio (when opening the folder as a CMake project): settings cache and its default
# build folder
.vs/
/out/
*.user

# Rendered and recorded audio (`piano-lab render` output, recordings); never committed
*.wav
*.wav.partial

# Crash dumps
*.dmp

# --- UI (Node, from step 0.7) ---------------------------------------------------------------------

node_modules/
dist/
*.tsbuildinfo
.vite/
coverage/
npm-debug.log*

# Playwright output
test-results/
playwright-report/
blob-report/
playwright/.cache/

# --- Secrets and personal settings ----------------------------------------------------------------

# Environment files can hold secrets; share a .env.example instead
.env
.env.*
!.env.example

# Claude Code: personal settings and notes (shared settings, rules and CLAUDE.md are committed)
.claude/settings.local.json
CLAUDE.local.md

# --- Editors and OS -------------------------------------------------------------------------------

# VS Code: share only the recommended extensions; settings stay personal
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~

Thumbs.db
desktop.ini
.DS_Store
