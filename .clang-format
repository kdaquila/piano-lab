# clang-format settings for piano-lab's C++ code (written for LLVM 23).
BasedOnStyle: LLVM
IndentWidth: 4
ColumnLimit: 100
AccessModifierOffset: -4
PointerAlignment: Left # int* p, not int *p
AllowShortFunctionsOnASingleLine: Inline
AllowShortLambdasOnASingleLine: All
# Local "..." headers, then our libraries, then third-party, then the standard library, each
# group sorted.
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"'
    Priority: 1
  - Regex: '^<pianolab/'
    Priority: 2
  - Regex: '^<(catch2|juce_[a-z_]+|httplib|nlohmann|rigtorp)/'
    Priority: 3
  - Regex: '^<[a-z_]+>$'
    Priority: 4
  - Regex: '.*'
    Priority: 3
