// Type-checks the end-to-end tests and the web UI's tool configs (`npm run check`). They run in
// Node, so they share the web server's settings.
{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "types": ["node"]
    },
    "include": [".", "../*.config.ts"]
}
