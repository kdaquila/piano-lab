{
    "name": "piano-lab",
    "private": true,
    "description": "A physically modelled piano. These scripts build, test and run it: see the README.",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=24.15.0"
    },
    "scripts": {
        "build": "run-s build:*",
        "build:server": "node scripts/server/build.ts",
        "test": "run-s test:*",
        "test:server": "node scripts/server/test.ts",
        "format": "run-s format:*",
        "format:server": "node scripts/server/format.ts",
        "lint": "run-s lint:*",
        "lint:server": "node scripts/server/lint.ts",
        "check": "run-s typecheck check:*",
        "check:server": "node scripts/server/check.ts",
        "typecheck": "tsc -p scripts",
        "start": "run-s start:*",
        "start:server": "node scripts/server/start.ts",
        "render": "node scripts/server/render.ts"
    },
    "devDependencies": {
        "@types/node": "24.19.4",
        "npm-run-all2": "9.1.0",
        "typescript": "7.0.2"
    }
}
