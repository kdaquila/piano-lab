{
    "name": "piano-lab",
    "private": true,
    "description": "A physically modelled piano. These scripts build, test and run it: see the README.",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=24.15.0"
    },
    "scripts": {
        "build": "run-s build:*",
        "build:audio": "node scripts/audio/build.ts",
        "build:web": "node scripts/web/build.ts",
        "build:ui": "node scripts/ui/build.ts",
        "test": "run-s test:*",
        "test:audio": "node scripts/audio/test.ts",
        "test:web": "node scripts/web/test.ts",
        "test:ui": "node scripts/ui/test.ts",
        "format": "run-s format:*",
        "format:audio": "node scripts/audio/format.ts",
        "format:web": "node scripts/web/format.ts",
        "format:ui": "node scripts/ui/format.ts",
        "lint": "run-s lint:*",
        "lint:audio": "node scripts/audio/lint.ts",
        "lint:web": "node scripts/web/lint.ts",
        "lint:ui": "node scripts/ui/lint.ts",
        "check": "run-s typecheck check:*",
        "check:audio": "node scripts/audio/check.ts",
        "check:web": "node scripts/web/check.ts",
        "check:ui": "node scripts/ui/check.ts",
        "typecheck": "tsc -p scripts",
        "start": "node scripts/web/start.ts",
        "start:ui": "node scripts/ui/start.ts",
        "start:audio": "node scripts/audio/start.ts",
        "render": "node scripts/audio/render.ts",
        "acceptance": "node scripts/web/acceptance.ts"
    },
    "devDependencies": {
        "@types/node": "24.19.4",
        "npm-run-all2": "9.1.0",
        "oxfmt": "0.80.0",
        "oxlint": "1.95.0",
        "typescript": "7.0.2",
        "vitest": "5.1.2"
    },
    "workspaces": [
        "web-api",
        "web-server",
        "web-ui"
    ]
}
