{
    // CMake Tools: use our presets (it sets up the Visual Studio environment itself).
    "cmake.useCMakePresets": "always",
    "cmake.configureOnOpen": true,

    // clangd does code intelligence from the exact build flags in the dev preset.
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/build/dev",
        "--clang-tidy",
        "--header-insertion=never"
    ],

    // Microsoft's C++ extension is only for debugging; clangd handles IntelliSense.
    "C_Cpp.intelliSenseEngine": "disabled",

    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.formatOnSave": true
    },
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true
}
